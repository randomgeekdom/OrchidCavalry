<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="OrchidCavalry.Views.CitiesView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{StaticResource Night}"
    Shell.NavBarIsVisible="False"
    Title="Cities">

    <Grid RowDefinitions="Auto,*">

        <Grid
            Padding="28,22,28,10"
            ColumnDefinitions="Auto,*"
            ColumnSpacing="18">
            <Button
                Clicked="OnBackClicked"
                Style="{StaticResource GhostButton}"
                Text="‹  Back"
                VerticalOptions="Center" />
            <Label
                Grid.Column="1"
                Style="{StaticResource PageTitle}"
                Text="Cities"
                VerticalOptions="Center" />
        </Grid>

        <CollectionView
            Grid.Row="1"
            Margin="28,10,28,30"
            ItemsSource="{Binding Cities}"
            SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                            <VerticalStackLayout Spacing="4">
                                <Label Style="{StaticResource CardTitle}" Text="{Binding Name}" />
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <Label Style="{StaticResource MutedLabel}" Text="Biome" />
                                    <Label Grid.Column="1" Text="{Binding Biome}" />
                                </Grid>
                            </VerticalStackLayout>
                            <VerticalStackLayout
                                Grid.Column="1"
                                HorizontalOptions="End"
                                Spacing="2">
                                <Label
                                    HorizontalTextAlignment="End"
                                    Style="{StaticResource StatValue}"
                                    Text="{Binding Population}" />
                                <Label
                                    HorizontalTextAlignment="End"
                                    Style="{StaticResource SectionTitle}"
                                    Text="POPULATION" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
