<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="OrchidCavalry.Popups.NewGame"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{StaticResource Night}"
    BindingContext="OrchidCavalry.Popups.NewGame"
    Shell.NavBarIsVisible="False"
    Title="New Game">

    <ScrollView VerticalScrollBarVisibility="Default">
        <VerticalStackLayout
            HorizontalOptions="Center"
            MaximumWidthRequest="720"
            Padding="30"
            Spacing="18"
            VerticalOptions="Center">

            <Label Style="{StaticResource PageTitle}" Text="A New Command" />

            <Label LineHeight="1.45" Text="{Binding OpeningText}" />

            <Border>
                <VerticalStackLayout Spacing="12">
                    <Label Style="{StaticResource SectionTitle}" Text="YOUR NAME" />
                    <Entry
                        Completed="StartGameAsync"
                        HorizontalTextAlignment="Start"
                        Keyboard="Text"
                        MaxLength="35"
                        Placeholder="Character first name?"
                        Text="{Binding Path=CharacterName, Mode=TwoWay}" />
                </VerticalStackLayout>
            </Border>

            <Button
                Clicked="StartGameAsync"
                IsEnabled="{Binding CanStart}"
                Style="{StaticResource PrimaryButton}"
                Text="Start Game" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
