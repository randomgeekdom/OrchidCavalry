<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="OrchidCavalry.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{StaticResource Night}"
    Shell.NavBarIsVisible="False"
    Title="Orchid Cavalry">

    <Grid>
        <VerticalStackLayout
            Padding="30"
            HorizontalOptions="Center"
            Spacing="30"
            VerticalOptions="Center">

            <Label
                FontFamily="GreatVibes"
                FontSize="96"
                HorizontalTextAlignment="Center"
                Text="Orchid Cavalry"
                TextColor="{StaticResource GoldBright}" />

            <BoxView
                Color="{StaticResource GoldHairline}"
                HeightRequest="1"
                HorizontalOptions="Center"
                WidthRequest="260" />

            <HorizontalStackLayout
                HorizontalOptions="Center"
                Spacing="18">
                <Button
                    x:Name="StartButton"
                    Clicked="StartButton_Clicked"
                    HorizontalOptions="Center"
                    Style="{StaticResource PrimaryButton}"
                    Text="PLAY"
                    WidthRequest="200" />
                <Button
                    x:Name="ExitButton"
                    Clicked="ExitButton_Clicked"
                    HorizontalOptions="Center"
                    Style="{StaticResource GhostButton}"
                    Text="EXIT"
                    WidthRequest="200" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
