<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="OrchidCavalry.Popups.ChoiceView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:OrchidCavalry.ViewModels"
    x:DataType="vm:ChoiceViewModel"
    BackgroundColor="{StaticResource Night}"
    Shell.NavBarIsVisible="False">

    <Grid Padding="30">
        <VerticalStackLayout
            HorizontalOptions="Center"
            MaximumWidthRequest="640"
            Spacing="18"
            VerticalOptions="Center">

            <Label
                HorizontalTextAlignment="Center"
                Style="{StaticResource CardTitle}"
                Text="{Binding Text}" />

            <Border>
                <VerticalStackLayout Spacing="10">
                    <Label Style="{StaticResource SectionTitle}" Text="CHOOSE" />
                    <Picker ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}" />
                </VerticalStackLayout>
            </Border>

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="14">
                <Button
                    Command="{Binding SelectCommand}"
                    IsEnabled="{Binding EnableSelect, Mode=TwoWay}"
                    Style="{StaticResource PrimaryButton}"
                    Text="Select"
                    WidthRequest="160" />
                <Button
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource GhostButton}"
                    Text="Cancel"
                    WidthRequest="160" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
